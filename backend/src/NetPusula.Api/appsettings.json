{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "AccessTokenMinutes": 15,
    "Audience": "NetPusula.Mobile",
    "Issuer": "NetPusula"
  },
  "Auth": {
    "RefreshTokenDays": 30
  },
  "AuthRateLimit": {
    "WindowSeconds": 60,
    "PermitLimit": 20
  }
}
